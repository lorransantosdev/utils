 "journeys": [
  {
   "title": "Checkout",
   "steps": [
    {
     "place": "gateway",
     "title": "1 · The order arrives",
     "text": "The app sends the cart to the gateway. It checks the token and the rate limit.",
     "payload": "POST /orders { cart: 3 items, total: 89.90 }"
    },
    {
     "move": {
      "from": "gateway",
      "to": "orders",
      "say": "POST /orders"
     },
     "title": "2 · Orders creates it",
     "text": "Orders saves it as PENDING and reserves the stock."
    },
    {
     "move": {
      "from": "orders",
      "to": "payments",
      "say": "charge 89.90"
     },
     "title": "3 · Payment",
     "text": "Payments charges the card. The order id is the idempotency key, so a retry never charges twice.",
     "payload": "{ \"status\": \"PAID\", \"psp_id\": \"ch_81f…\" }"
    },
    {
     "move": {
      "from": "payments",
      "to": "stock",
      "say": "ship order 4127"
     },
     "title": "4 · Ship it",
     "text": "The warehouse picks the parcel; a van leaves."
    },
    {
     "move": {
      "from": "stock",
      "to": "notify",
      "say": "order shipped"
     },
     "title": "5 · Tell the customer",
     "text": "Notifications sends “your order is on the way”."
    },
    {
     "ref": {
      "t": "home"
     },
     "title": "Done",
     "text": "5 services, ~1.2 s end to end."
    }
   ]
  },
  {
   "title": "Card declined",
   "steps": [
    {
     "move": {
      "from": "gateway",
      "to": "orders"
     },
     "title": "1 · Same start",
     "text": "Order created as PENDING."
    },
    {
     "move": {
      "from": "orders",
      "to": "payments"
     },
     "place": "payments",
     "fail": true,
     "title": "2 · Declined",
     "text": "The PSP says “insufficient funds”. Payments answers 402 and the order is cancelled; the stock is released.",
     "payload": "{ \"error\": \"card_declined\", \"code\": 402 }"
    },
    {
     "place": "notify",
     "title": "3 · Tell the customer",
     "text": "A friendly message with a link to try another card."
    }
   ]
  }
 ],
