# Keys for sync.mjs — copy this file to .env and fill in only the ones you use. .env is git-ignored.
# Read-only keys only: the city looks at your numbers, it never changes anything or moves money.
STRIPE_KEY=            # restricted key with Read on Charges + Customers (Dashboard → Developers → API keys → Create restricted key)
SHOPIFY_STORE=         # my-store.myshopify.com
SHOPIFY_TOKEN=         # custom app token with read_orders, read_products, read_inventory
SQUARE_TOKEN=          # production access token with read-only scopes
SHEET_CSV_URL=         # Google Sheet → File → Share → Publish to web → CSV link
CURRENCY=USD
